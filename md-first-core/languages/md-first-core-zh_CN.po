#: includes/class-mdf-admin.php
msgid "Markup"
msgstr "Markup"

#: includes/class-mdf-admin.php
msgid "Preview"
msgstr "预览"

#: includes/class-mdf-admin.php
msgid "Loading preview …"
msgstr "正在加载预览 …"

#: includes/class-mdf-admin.php
msgid "The preview could not be loaded."
msgstr "无法加载预览。"

#: includes/class-mdf-admin.php
msgid "No content yet — write in the Markup tab, then open the preview."
msgstr "尚无内容 — 请在 Markup 选项卡中编写，然后打开预览。"

#: includes/class-mdf-admin.php
msgid "Undo (Ctrl+Z)"
msgstr "撤销 (Ctrl+Z)"

#: includes/class-mdf-admin.php
msgid "Redo (Ctrl+Shift+Z)"
msgstr "重做 (Ctrl+Shift+Z)"

#: includes/class-mdf-admin.php
msgid "Bold (**text**)"
msgstr "加粗 (**text**)"

#: includes/class-mdf-admin.php
msgid "Italic (*text*)"
msgstr "斜体 (*text*)"

#: includes/class-mdf-admin.php
msgid "Strikethrough (~~text~~)"
msgstr "删除线 (~~text~~)"

#: includes/class-mdf-admin.php
msgid "Link — \"Insert/edit link\" dialog (standard-WP) → [text](URL)"
msgstr "链接 — “插入/编辑链接”对话框（WP 标准）→ [text](URL)"

#: includes/class-mdf-admin.php
msgid "Image — original prompt (src, alt) → ![alt](src)"
msgstr "图片 — 原始提示（src, alt）→ ![alt](src)"

#: includes/class-mdf-admin.php
msgid "Bulleted list (- item)"
msgstr "无序列表 (- item)"

#: includes/class-mdf-admin.php
msgid "Numbered list (1. item)"
msgstr "有序列表 (1. item)"

#: includes/class-mdf-admin.php
msgid "Blockquote (> text)"
msgstr "引用块 (> text)"

#: includes/class-mdf-admin.php
msgid "Code (`inline` / ```block```)"
msgstr "代码 (`inline` / ```block```)"

#: includes/class-mdf-admin.php
msgid "Footnote — selected text becomes [^N]; definition added at the end of the post"
msgstr "脚注 — 选中文本变为 [^N]；定义追加到文章末尾"

#: includes/class-mdf-admin.php
msgid "Session invalid, please reload the page."
msgstr "会话已失效，请重新加载页面。"

#: includes/class-mdf-admin.php
msgid "Permission denied."
msgstr "权限不足。"

#: includes/class-mdf-admin.php
msgid "Content too large for the preview."
msgstr "内容过大，无法预览。"

#: includes/class-mdf-admin.php
msgid "Renderer not available."
msgstr "渲染器不可用。"

#: includes/class-mdf-admin.php
msgid "Preview rendering failed."
msgstr "预览渲染失败。"

#: includes/class-mdf-settings.php
msgid "Markdown First"
msgstr "Markdown First"

#: includes/class-mdf-settings.php
msgid "Settings apply to the mdf/* abilities and the Markdown endpoints (.md routes, /llms.txt). Saved per site; defaults listed as placeholder values."
msgstr "设置适用于 mdf/* 能力（abilities）和 Markdown 端点（.md 路由、/llms.txt）。按站点保存；默认值以占位符形式列出。"

#: includes/class-mdf-settings.php
msgid "Markdown endpoints"
msgstr "Markdown 端点"

#: includes/class-mdf-settings.php
msgid "Serve /<slug>.md and respect \"Accept: text/markdown\"."
msgstr "提供 /<slug>.md 并遵循 “Accept: text/markdown”。"

#: includes/class-mdf-settings.php
msgid "llms.txt"
msgstr "llms.txt"

#: includes/class-mdf-settings.php
msgid "Serve /llms.txt and /llms-full.txt."
msgstr "提供 /llms.txt 和 /llms-full.txt。"

#: includes/class-mdf-settings.php
msgid "List size limit"
msgstr "列表大小上限"

#: includes/class-mdf-settings.php
msgid "Maximum per_page accepted by mdf/list-posts-markdown (1–500)."
msgstr "mdf/list-posts-markdown 接受的最大 per_page（1–500）。"

#: includes/class-mdf-settings.php
msgid "Excerpt length"
msgstr "摘要长度"

#: includes/class-mdf-settings.php
msgid "Auto-excerpt length in words for list and the_excerpt (5–200)."
msgstr "列表和 the_excerpt 的自动摘要词数（5–200）。"
