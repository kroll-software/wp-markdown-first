#: includes/class-mdf-admin.php
msgid "Markup"
msgstr "Markup"

#: includes/class-mdf-admin.php
msgid "Preview"
msgstr "Vista previa"

#: includes/class-mdf-admin.php
msgid "Loading preview …"
msgstr "Cargando vista previa …"

#: includes/class-mdf-admin.php
msgid "The preview could not be loaded."
msgstr "No se pudo cargar la vista previa."

#: includes/class-mdf-admin.php
msgid "No content yet — write in the Markup tab, then open the preview."
msgstr "Aún no hay contenido: escribe en la pestaña Markup y abre la vista previa."

#: includes/class-mdf-admin.php
msgid "Undo (Ctrl+Z)"
msgstr "Deshacer (Ctrl+Z)"

#: includes/class-mdf-admin.php
msgid "Redo (Ctrl+Shift+Z)"
msgstr "Rehacer (Ctrl+Mayús+Z)"

#: includes/class-mdf-admin.php
msgid "Bold (**text**)"
msgstr "Negrita (**texto**)"

#: includes/class-mdf-admin.php
msgid "Italic (*text*)"
msgstr "Cursiva (*texto*)"

#: includes/class-mdf-admin.php
msgid "Strikethrough (~~text~~)"
msgstr "Tachado (~~texto~~)"

#: includes/class-mdf-admin.php
msgid "Link — \"Insert/edit link\" dialog (standard-WP) → [text](URL)"
msgstr "Enlace — diálogo «Insertar/editar enlace» (WP estándar) → [texto](URL)"

#: includes/class-mdf-admin.php
msgid "Image — original prompt (src, alt) → ![alt](src)"
msgstr "Imagen — prompts originales (src, alt) → ![alt](src)"

#: includes/class-mdf-admin.php
msgid "Bulleted list (- item)"
msgstr "Lista con viñetas (- item)"

#: includes/class-mdf-admin.php
msgid "Numbered list (1. item)"
msgstr "Lista numerada (1. item)"

#: includes/class-mdf-admin.php
msgid "Blockquote (> text)"
msgstr "Cita bloqueada (> texto)"

#: includes/class-mdf-admin.php
msgid "Code (`inline` / ```block```)"
msgstr "Código (`inline` / ```block```)"

#: includes/class-mdf-admin.php
msgid "Footnote — selected text becomes [^N]; definition added at the end of the post"
msgstr "Nota al pie — la selección pasa a [^N]; se añade la definición al final de la publicación"

#: includes/class-mdf-admin.php
msgid "Session invalid, please reload the page."
msgstr "Sesión no válida, recarga la página."

#: includes/class-mdf-admin.php
msgid "Permission denied."
msgstr "Permiso denegado."

#: includes/class-mdf-admin.php
msgid "Content too large for the preview."
msgstr "Contenido demasiado grande para la vista previa."

#: includes/class-mdf-admin.php
msgid "Renderer not available."
msgstr "Renderizador no disponible."

#: includes/class-mdf-admin.php
msgid "Preview rendering failed."
msgstr "Error al renderizar la vista previa."

#: includes/class-mdf-settings.php
msgid "Markdown First"
msgstr "Markdown First"

#: includes/class-mdf-settings.php
msgid "Settings apply to the mdf/* abilities and the Markdown endpoints (.md routes, /llms.txt). Saved per site; defaults listed as placeholder values."
msgstr "Los ajustes se aplican a las abilities mdf/* y a los endpoints de Markdown (rutas .md, /llms.txt). Se guardan por sitio; los valores por defecto se listan como referencias."

#: includes/class-mdf-settings.php
msgid "Markdown endpoints"
msgstr "Endpoints de Markdown"

#: includes/class-mdf-settings.php
msgid "Serve /<slug>.md and respect \"Accept: text/markdown\"."
msgstr "Sirve /<slug>.md y respeta «Accept: text/markdown»."

#: includes/class-mdf-settings.php
msgid "llms.txt"
msgstr "llms.txt"

#: includes/class-mdf-settings.php
msgid "Serve /llms.txt and /llms-full.txt."
msgstr "Sirve /llms.txt y /llms-full.txt."

#: includes/class-mdf-settings.php
msgid "List size limit"
msgstr "Límite de tamaño de lista"

#: includes/class-mdf-settings.php
msgid "Maximum per_page accepted by mdf/list-posts-markdown (1–500)."
msgstr "per_page máximo aceptado por mdf/list-posts-markdown (1–500)."

#: includes/class-mdf-settings.php
msgid "Excerpt length"
msgstr "Longitud del extracto"

#: includes/class-mdf-settings.php
msgid "Auto-excerpt length in words for list and the_excerpt (5–200)."
msgstr "Longitud del extracto automático en palabras para la lista y the_excerpt (5–200)."
