#: includes/class-mdf-admin.php
msgid "Markup"
msgstr "Markup"

#: includes/class-mdf-admin.php
msgid "Preview"
msgstr "Vorschau"

#: includes/class-mdf-admin.php
msgid "Loading preview …"
msgstr "Vorschau wird geladen …"

#: includes/class-mdf-admin.php
msgid "The preview could not be loaded."
msgstr "Vorschau konnte nicht geladen werden."

#: includes/class-mdf-admin.php
msgid "No content yet — write in the Markup tab, then open the preview."
msgstr "Noch keine Inhalte — im Markup-Tab schreiben, dann Vorschau öffnen."

#: includes/class-mdf-admin.php
msgid "Undo (Ctrl+Z)"
msgstr "Rückgängig (Strg+Z)"

#: includes/class-mdf-admin.php
msgid "Redo (Ctrl+Shift+Z)"
msgstr "Wiederherstellen (Strg+Shift+Z)"

#: includes/class-mdf-admin.php
msgid "Bold (**text**)"
msgstr "Fett (**text**)"

#: includes/class-mdf-admin.php
msgid "Italic (*text*)"
msgstr "Kursiv (*text*)"

#: includes/class-mdf-admin.php
msgid "Strikethrough (~~text~~)"
msgstr "Durchgestrichen (~~text~~)"

#: includes/class-mdf-admin.php
msgid "Link — \"Insert/edit link\" dialog (standard-WP) → [text](URL)"
msgstr "Link — „Insert/edit link“-Dialog (Standard-WP) → [Text](URL)"

#: includes/class-mdf-admin.php
msgid "Image — original prompt (src, alt) → ![alt](src)"
msgstr "Bild — Original-Prompts (src, alt) → ![Alt](src)"

#: includes/class-mdf-admin.php
msgid "Bulleted list (- item)"
msgstr "Aufzählung (- item)"

#: includes/class-mdf-admin.php
msgid "Numbered list (1. item)"
msgstr "Nummerierte Liste (1. item)"

#: includes/class-mdf-admin.php
msgid "Blockquote (> text)"
msgstr "Zitat (> text)"

#: includes/class-mdf-admin.php
msgid "Code (`inline` / ```block```)"
msgstr "Code (`inline` / ```block```)"

#: includes/class-mdf-admin.php
msgid "Footnote — selected text becomes [^N]; definition added at the end of the post"
msgstr "Fußnote — Auswahl wird zu [^N]; Definition am Ende des Beitrags"

#: includes/class-mdf-admin.php
msgid "Session invalid, please reload the page."
msgstr "Sitzung ungültig, bitte neu laden."

#: includes/class-mdf-admin.php
msgid "Permission denied."
msgstr "Keine Berechtigung."

#: includes/class-mdf-admin.php
msgid "Content too large for the preview."
msgstr "Inhalt zu groß für Vorschau."

#: includes/class-mdf-admin.php
msgid "Renderer not available."
msgstr "Renderer nicht verfügbar."

#: includes/class-mdf-admin.php
msgid "Preview rendering failed."
msgstr "Vorschau-Rendering fehlgeschlagen."

#: includes/class-mdf-settings.php
msgid "Markdown First"
msgstr "Markdown First"

#: includes/class-mdf-settings.php
msgid "Settings apply to the mdf/* abilities and the Markdown endpoints (.md routes, /llms.txt). Saved per site; defaults listed as placeholder values."
msgstr "Einstellungen gelten für die mdf/*-Abilities und die Markdown-Endpunkte (.md-Routen, /llms.txt). Pro Site gespeichert; Standardwerte als Platzhalter angegeben."

#: includes/class-mdf-settings.php
msgid "Markdown endpoints"
msgstr "Markdown-Endpunkte"

#: includes/class-mdf-settings.php
msgid "Serve /<slug>.md and respect \"Accept: text/markdown\"."
msgstr "Bietet /<slug>.md an und beachtet „Accept: text/markdown“."

#: includes/class-mdf-settings.php
msgid "llms.txt"
msgstr "llms.txt"

#: includes/class-mdf-settings.php
msgid "Serve /llms.txt and /llms-full.txt."
msgstr "Bietet /llms.txt und /llms-full.txt an."

#: includes/class-mdf-settings.php
msgid "List size limit"
msgstr "Maximale Listenlänge"

#: includes/class-mdf-settings.php
msgid "Maximum per_page accepted by mdf/list-posts-markdown (1–500)."
msgstr "Maximales per_page, das mdf/list-posts-markdown akzeptiert (1–500)."

#: includes/class-mdf-settings.php
msgid "Excerpt length"
msgstr "Excerpt-Länge"

#: includes/class-mdf-settings.php
msgid "Auto-excerpt length in words for list and the_excerpt (5–200)."
msgstr "Automatische Excerpt-Länge in Wörtern für Liste und the_excerpt (5–200)."
