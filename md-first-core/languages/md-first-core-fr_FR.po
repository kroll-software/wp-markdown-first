#: includes/class-mdf-admin.php
msgid "Markup"
msgstr "Markup"

#: includes/class-mdf-admin.php
msgid "Preview"
msgstr "Aperçu"

#: includes/class-mdf-admin.php
msgid "Loading preview …"
msgstr "Chargement de l’aperçu …"

#: includes/class-mdf-admin.php
msgid "The preview could not be loaded."
msgstr "L’aperçu n’a pas pu être chargé."

#: includes/class-mdf-admin.php
msgid "No content yet — write in the Markup tab, then open the preview."
msgstr "Pas encore de contenu — écrivez dans l’onglet Markup, puis ouvrez l’aperçu."

#: includes/class-mdf-admin.php
msgid "Undo (Ctrl+Z)"
msgstr "Annuler (Ctrl+Z)"

#: includes/class-mdf-admin.php
msgid "Redo (Ctrl+Shift+Z)"
msgstr "Rétablir (Ctrl+Maj+Z)"

#: includes/class-mdf-admin.php
msgid "Bold (**text**)"
msgstr "Gras (**texte**)"

#: includes/class-mdf-admin.php
msgid "Italic (*text*)"
msgstr "Italique (*texte*)"

#: includes/class-mdf-admin.php
msgid "Strikethrough (~~text~~)"
msgstr "Barré (~~texte~~)"

#: includes/class-mdf-admin.php
msgid "Link — \"Insert/edit link\" dialog (standard-WP) → [text](URL)"
msgstr "Lien — boîte « Insérer/modifier un lien » (WP standard) → [texte](URL)"

#: includes/class-mdf-admin.php
msgid "Image — original prompt (src, alt) → ![alt](src)"
msgstr "Image — invite d’origine (src, alt) → ![alt](src)"

#: includes/class-mdf-admin.php
msgid "Bulleted list (- item)"
msgstr "Liste à puces (- item)"

#: includes/class-mdf-admin.php
msgid "Numbered list (1. item)"
msgstr "Liste numérotée (1. item)"

#: includes/class-mdf-admin.php
msgid "Blockquote (> text)"
msgstr "Citation bloquée (> texte)"

#: includes/class-mdf-admin.php
msgid "Code (`inline` / ```block```)"
msgstr "Code (`inline` / ```block```)"

#: includes/class-mdf-admin.php
msgid "Footnote — selected text becomes [^N]; definition added at the end of the post"
msgstr "Note de bas de page — la sélection devient [^N] ; définition ajoutée à la fin de l’article"

#: includes/class-mdf-admin.php
msgid "Session invalid, please reload the page."
msgstr "Session invalide, veuillez recharger la page."

#: includes/class-mdf-admin.php
msgid "Permission denied."
msgstr "Permission refusée."

#: includes/class-mdf-admin.php
msgid "Content too large for the preview."
msgstr "Contenu trop volumineux pour l’aperçu."

#: includes/class-mdf-admin.php
msgid "Renderer not available."
msgstr "Moteur de rendu indisponible."

#: includes/class-mdf-admin.php
msgid "Preview rendering failed."
msgstr "Échec du rendu de l’aperçu."

#: includes/class-mdf-settings.php
msgid "Markdown First"
msgstr "Markdown First"

#: includes/class-mdf-settings.php
msgid "Settings apply to the mdf/* abilities and the Markdown endpoints (.md routes, /llms.txt). Saved per site; defaults listed as placeholder values."
msgstr "Les réglages s’appliquent aux abilities mdf/* et aux points de terminaison Markdown (routes .md, /llms.txt). Stockés par site ; valeurs par défaut indiquées à titre de référence."

#: includes/class-mdf-settings.php
msgid "Markdown endpoints"
msgstr "Points de terminaison Markdown"

#: includes/class-mdf-settings.php
msgid "Serve /<slug>.md and respect \"Accept: text/markdown\"."
msgstr "Sert /<slug>.md et respecte « Accept: text/markdown »."

#: includes/class-mdf-settings.php
msgid "llms.txt"
msgstr "llms.txt"

#: includes/class-mdf-settings.php
msgid "Serve /llms.txt and /llms-full.txt."
msgstr "Sert /llms.txt et /llms-full.txt."

#: includes/class-mdf-settings.php
msgid "List size limit"
msgstr "Limite de taille de liste"

#: includes/class-mdf-settings.php
msgid "Maximum per_page accepted by mdf/list-posts-markdown (1–500)."
msgstr "per_page maximal accepté par mdf/list-posts-markdown (1–500)."

#: includes/class-mdf-settings.php
msgid "Excerpt length"
msgstr "Longueur de l’extrait"

#: includes/class-mdf-settings.php
msgid "Auto-excerpt length in words for list and the_excerpt (5–200)."
msgstr "Longueur de l’extrait automatique en mots pour la liste et the_excerpt (5–200)."
