#: includes/class-mdf-admin.php
msgid "Markup"
msgstr "Markup"

#: includes/class-mdf-admin.php
msgid "Preview"
msgstr "Pré-visualização"

#: includes/class-mdf-admin.php
msgid "Loading preview …"
msgstr "A carregar a pré-visualização …"

#: includes/class-mdf-admin.php
msgid "The preview could not be loaded."
msgstr "Não foi possível carregar a pré-visualização."

#: includes/class-mdf-admin.php
msgid "No content yet — write in the Markup tab, then open the preview."
msgstr "Ainda sem conteúdo — escreva no separador Markup e abra a pré-visualização."

#: includes/class-mdf-admin.php
msgid "Undo (Ctrl+Z)"
msgstr "Anular (Ctrl+Z)"

#: includes/class-mdf-admin.php
msgid "Redo (Ctrl+Shift+Z)"
msgstr "Repetir (Ctrl+Shift+Z)"

#: includes/class-mdf-admin.php
msgid "Bold (**text**)"
msgstr "Negrito (**text**)"

#: includes/class-mdf-admin.php
msgid "Italic (*text*)"
msgstr "Itálico (*text*)"

#: includes/class-mdf-admin.php
msgid "Strikethrough (~~text~~)"
msgstr "Ratado (~~text~~)"

#: includes/class-mdf-admin.php
msgid "Link — \"Insert/edit link\" dialog (standard-WP) → [text](URL)"
msgstr "Ligação — diálogo «Inserir/Editar ligação» (WP padrão) → [text](URL)"

#: includes/class-mdf-admin.php
msgid "Image — original prompt (src, alt) → ![alt](src)"
msgstr "Imagem — prompt original (src, alt) → ![alt](src)"

#: includes/class-mdf-admin.php
msgid "Bulleted list (- item)"
msgstr "Lista com marcadores (- item)"

#: includes/class-mdf-admin.php
msgid "Numbered list (1. item)"
msgstr "Lista numerada (1. item)"

#: includes/class-mdf-admin.php
msgid "Blockquote (> text)"
msgstr "Citação em bloco (> text)"

#: includes/class-mdf-admin.php
msgid "Code (`inline` / ```block```)"
msgstr "Código (`inline` / ```block```)"

#: includes/class-mdf-admin.php
msgid "Footnote — selected text becomes [^N]; definition added at the end of the post"
msgstr "Nota de rodapé — o texto selecionado passa a [^N]; a definição é adicionada no fim do artigo"

#: includes/class-mdf-admin.php
msgid "Session invalid, please reload the page."
msgstr "Sessão inválida, por favor recarregue a página."

#: includes/class-mdf-admin.php
msgid "Permission denied."
msgstr "Permissão negada."

#: includes/class-mdf-admin.php
msgid "Content too large for the preview."
msgstr "Conteúdo demasiado grande para a pré-visualização."

#: includes/class-mdf-admin.php
msgid "Renderer not available."
msgstr "Renderizador indisponível."

#: includes/class-mdf-admin.php
msgid "Preview rendering failed."
msgstr "Falha na renderização da pré-visualização."

#: includes/class-mdf-settings.php
msgid "Markdown First"
msgstr "Markdown First"

#: includes/class-mdf-settings.php
msgid "Settings apply to the mdf/* abilities and the Markdown endpoints (.md routes, /llms.txt). Saved per site; defaults listed as placeholder values."
msgstr "As definições aplicam-se às abilities mdf/* e aos endpoints Markdown (rotas .md, /llms.txt). Guardadas por site; os valores predefinidos são listados como referência."

#: includes/class-mdf-settings.php
msgid "Markdown endpoints"
msgstr "Endpoints Markdown"

#: includes/class-mdf-settings.php
msgid "Serve /<slug>.md and respect \"Accept: text/markdown\"."
msgstr "Serve /<slug>.md e respeita \"Accept: text/markdown\"."

#: includes/class-mdf-settings.php
msgid "llms.txt"
msgstr "llms.txt"

#: includes/class-mdf-settings.php
msgid "Serve /llms.txt and /llms-full.txt."
msgstr "Serve /llms.txt e /llms-full.txt."

#: includes/class-mdf-settings.php
msgid "List size limit"
msgstr "Limite de tamanho da lista"

#: includes/class-mdf-settings.php
msgid "Maximum per_page accepted by mdf/list-posts-markdown (1–500)."
msgstr "per_page máximo aceite por mdf/list-posts-markdown (1–500)."

#: includes/class-mdf-settings.php
msgid "Excerpt length"
msgstr "Comprimento do excerto"

#: includes/class-mdf-settings.php
msgid "Auto-excerpt length in words for list and the_excerpt (5–200)."
msgstr "Comprimento do excerto automático em palavras para a lista e the_excerpt (5–200)."
